{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/pages/privacy.html"
    },
    {
      "source": "/privacy",
      "destination": "/pages/privacy.html"
    },
    {
      "source": "/policies/privacy",
      "destination": "/pages/privacy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/pages/terms.html"
    },
    {
      "source": "/terms",
      "destination": "/pages/terms.html"
    },
    {
      "source": "/policies/terms",
      "destination": "/pages/terms.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/pages/cookies.html"
    },
    {
      "source": "/policies/cookies",
      "destination": "/pages/cookies.html"
    },
    {
      "source": "/accessibility-policy",
      "destination": "/pages/accessibility.html"
    },
    {
      "source": "/policies/accessibility",
      "destination": "/pages/accessibility.html"
    },
    {
      "source": "/ai-ethics",
      "destination": "/pages/ai-ethics.html"
    },
    {
      "source": "/policies/ai-ethics",
      "destination": "/pages/ai-ethics.html"
    },
    {
      "source": "/policies",
      "destination": "/pages/policies.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
